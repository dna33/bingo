# Local development only: use a different secret outside this environment.
# Transactions require an initialized replica set (even for one local MongoDB).
DB_URI=mongodb://127.0.0.1:27017/bingo_local?replicaSet=bingo-rs
DB_SECRET=replace-with-a-local-development-secret
PORT=8888
# API bind address; public URLs below do not change its internal /bingo-api route.
HOST=127.0.0.1
# Console deployment directory (not back-office.html); API root including /bingo-api.
CONSOLE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8888/bingo-api
# Exact origins, comma separated. If omitted, defaults to the origin of CONSOLE_URL.
CORS_ALLOWED_ORIGINS=http://localhost:8000
# Use production with explicit HTTPS URLs, DB_SECRET >=32 characters and a verified build.
NODE_ENV=development
HEALTH_TIMEOUT_MS=1000
STARTUP_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
# T-03 real messaging adapters. All optional: omitted, both channels keep using the simulated
# mock-provider (see docs/T_03_ADAPTADOR_MENSAJERIA_REAL.md). Never used with real credentials
# outside an explicit, separately authorized sandbox/test account.
# DELIVERY_EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-with-a-sandbox-smtp-user
# SMTP_PASS=replace-with-a-sandbox-smtp-password
# SMTP_FROM=bingo@example.invalid
# SMTP_SANDBOX_MODE=true
# DELIVERY_WHATSAPP_PROVIDER=meta_cloud_api
# WHATSAPP_PHONE_NUMBER_ID=replace-with-a-sandbox-phone-number-id
# WHATSAPP_ACCESS_TOKEN=replace-with-a-sandbox-access-token
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_API_BASE_URL=https://graph.facebook.com
# WHATSAPP_TEMPLATE_NAME=replace-with-an-approved-template-name
# WHATSAPP_TEMPLATE_LANG=es
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-local-verify-token
# WHATSAPP_APP_SECRET=replace-with-a-sandbox-app-secret
# WHATSAPP_SANDBOX_MODE=true
